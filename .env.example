# Copy to .env and fill in the services you have. Every key is optional:
# missing STT/TTS keys fall back to local models, a missing LLM key limits you to the
# mocked text harness, and missing Twilio keys limit you to the local mic transport.
# Run `cva-check-env` to see what is configured (it prints names, never values).

# LLM (Claude, tool use)
ANTHROPIC_API_KEY=

# Speech-to-text and text-to-speech (Deepgram covers both)
DEEPGRAM_API_KEY=

# Optional alternative TTS providers
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Telephony (Twilio Media Streams). You create the account and number yourself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
